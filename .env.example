# Copy to .env and fill in. Never commit .env. Secrets live here only, never in code or logs.
# Variables are grouped by the phase that first reads them.

# --- App (Phase 1) ---------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
POLICY_PATH=app/policy/policy.yaml   # relative paths resolve against backend/

# --- Database (Phase 1) ----------------------------------------------------------------
# One Postgres (with pgvector) for app data, LangGraph checkpoints and KB vectors.
POSTGRES_USER=refund
POSTGRES_PASSWORD=change-me
POSTGRES_DB=refund_matrix
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://refund:change-me@localhost:5432/refund_matrix

# --- LLM providers (Phase 3, Ollama in Phase 10) -----------------------------------------
LLM_PROVIDER=groq                   # groq | ollama
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3                   # backoff retries, honouring Retry-After
LLM_MAX_RETRY_WAIT_SECONDS=20       # longer Retry-After => don't wait, fall back / hand off
TRIAGE_CONFIDENCE_THRESHOLD=0.7     # below this => resolution agent
PROMPT_VERSION=v1

GROQ_API_KEY=
# Model names are config, not code. Check Groq's current model list before use.
GROQ_MODEL_TRIAGE=llama-3.1-8b-instant       # 8B-class: triage
GROQ_MODEL_AGENT=llama-3.3-70b-versatile     # 70B-class: refund intake, resolution, responder

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=                                # 7-8B instruct model with tool/JSON support

# --- Embeddings and RAG (Phase 5) --------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5       # swap for a multilingual model if needed
EMBEDDING_DIM=384                            # must match the model
RAG_MIN_SIMILARITY=0.35                      # below this => "I don't know" + human handoff
RAG_TOP_K=5

# --- Tracing (Phase 6) -------------------------------------------------------------------
# Tracing is optional. If off or unreachable, the app behaves identically.
TRACING_ENABLED=false
TRACING_SAMPLE_RATE=1.0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Payout simulation (Phase 7) ---------------------------------------------------------
PAYOUT_GATEWAY=mock

# --- API and security (Phase 8) ----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false                 # true in production (HTTPS)
CORS_ALLOWED_ORIGINS=http://localhost:5173  # comma-separated allowlist
RATE_LIMIT_PER_MINUTE=30

# --- Frontend (Phase 9) ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
