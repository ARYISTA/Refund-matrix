    { "id": "S12", "customer_id": "C-003", "order_id": "ORD-3001", "reason": "damaged", "claim": "whole_order", "amount_paise": 119800, "expected_at_5000": "ESCALATE", "expected_at_2000": "ESCALATE", "why": "3 refunds already in the last 30 days." },
    { "id": "S13", "customer_id": "C-003", "order_id": "ORD-3005", "reason": "not_delivered", "claim": "whole_order", "amount_paise": 199900, "expected_at_5000": "REJECT", "expected_at_2000": "REJECT", "why": "Payment was not captured." },
    { "id": "S14", "customer_id": "C-001", "order_id": "ORD-2001", "reason": "damaged", "claim": "whole_order", "amount_paise": null, "expected_at_5000": "REJECT", "expected_at_2000": "REJECT", "why": "Order belongs to another customer; must be treated as not found and no details revealed." }
