  "test_scenarios": [
    { "id": "S01", "customer_id": "C-001", "order_id": "ORD-1001", "reason": "damaged", "claim": "whole_order", "amount_paise": 249900, "expected_at_5000": "AUTO_APPROVE", "expected_at_2000": "ESCALATE", "why": "Between the two thresholds." },
    { "id": "S02", "customer_id": "C-001", "order_id": "ORD-1002", "reason": "defective", "claim": "whole_order", "amount_paise": 749900, "expected_at_5000": "ESCALATE", "expected_at_2000": "ESCALATE", "why": "High value." },
    { "id": "S03", "customer_id": "C-001", "order_id": "ORD-1003", "reason": "wrong_item", "claim": "whole_order", "amount_paise": 54800, "expected_at_5000": "AUTO_APPROVE", "expected_at_2000": "AUTO_APPROVE", "why": "Low value, includes shipping because the whole order is refunded." },
    { "id": "S04", "customer_id": "C-001", "order_id": "ORD-1004", "reason": "damaged", "claim": "whole_order", "amount_paise": 399900, "expected_at_5000": "REJECT", "expected_at_2000": "REJECT", "why": "Outside the return window." },
    { "id": "S05", "customer_id": "C-001", "order_id": "ORD-1005", "reason": "not_delivered", "claim": "whole_order", "amount_paise": 199900, "expected_at_5000": "AUTO_APPROVE", "expected_at_2000": "AUTO_APPROVE", "why": "Rs 1,999 is strictly below Rs 2,000. Valid because the expected delivery date has passed." },
    { "id": "S06", "customer_id": "C-002", "order_id": "ORD-2001", "reason": "damaged", "claim": "whole_order", "amount_paise": 149900, "expected_at_5000": "AUTO_APPROVE", "expected_at_2000": "AUTO_APPROVE", "why": "Low value." },
    { "id": "S07", "customer_id": "C-002", "order_id": "ORD-2002", "reason": "damaged", "claim": "whole_order", "amount_paise": 549900, "expected_at_5000": "ESCALATE", "expected_at_2000": "ESCALATE", "why": "At or above the threshold." },
    { "id": "S08", "customer_id": "C-002", "order_id": "ORD-2003", "reason": "damaged", "claim": "whole_order", "amount_paise": 199900, "expected_at_5000": "REJECT", "expected_at_2000": "REJECT", "why": "Already fully refunded." },
