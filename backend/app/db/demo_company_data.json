    { "id": "S10", "customer_id": "C-002", "order_id": "ORD-2004", "reason": "damaged", "claim": "3_items", "amount_paise": 239700, "expected_at_5000": "REJECT", "expected_at_2000": "REJECT", "why": "Exceeds the remaining refundable amount of 159800 paise." },
